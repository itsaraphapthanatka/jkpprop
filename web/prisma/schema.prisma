// JKP Property — backend schema (v1, single-tenant with orgId everywhere)
// Contract: FRONTEND_API_SPEC.md — payload shapes mirror web/src/lib/*.ts stores.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id            String   @id @default(cuid())
  name          String
  // TypeConfig (§3.2): property-type keys switched off for this agency
  disabledTypes String[] @default([])
  /* ลำดับเมนูประเภททรัพย์บนแถบบนสุด — เก็บเป็น key เรียงตามที่ทีมจัดไว้
     ว่าง = ใช้ลำดับตั้งต้นใน lib/navMenus.ts · key ที่ไม่รู้จักถูกข้าม และ
     ประเภทที่เพิ่มใหม่ทีหลังต่อท้ายเอง ไม่หายไปจากเมนู */
  navOrder      String[] @default([])
  // NotifyConfig (§7.2) minus readIds — org-wide thresholds; readIds live per user
  notifyConfig  Json?
  createdAt     DateTime @default(now())

  users      User[]
  properties Property[]
  leads      Lead[]
}

model User {
  id                 String    @id @default(cuid())
  orgId              String
  org                Org       @relation(fields: [orgId], references: [id])
  email              String    @unique
  passwordHash       String
  name               String
  phone              String?
  /* สไลด์ 45 · "ไม่มีหน้าที่ใส่ข้อมูลโปรไฟล์ของฉัน ควรตั้งชื่อได้ เบอร์โทร LINE
     ที่อยู่ปัจจุบัน" — ชื่อกับเบอร์มีอยู่แล้ว อีกสองช่องเพิ่มใหม่
     ใช้กับสมุดรายชื่อทีม (สไลด์ 45 ข้อ 3) ไม่ได้ส่งออกหน้าเว็บสาธารณะ */
  line               String?
  address            String?
  // RBAC (§12) — mirrors web/src/lib/rbac.ts
  role               String    @default("agent") // owner|manager|agent|co_agent|ops|marketing|translator
  scope              String    @default("own") // own|all
  privileges         String[]  @default([]) // pii|publish|price|deal_unlock|internal_note|export|audit
  expiresAt          DateTime? // required for co_agent
  active             Boolean   @default(true)
  // lease-alert ids the user marked read (§7.2 readIds)
  readAlertIds       String[]  @default([])
  // set when an admin issues a temporary password — blocks everything until
  // the user picks their own, so a handed-over password can't become permanent
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())

  sessions Session[]
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Field Builder override per property type (§3.1) — SchemaOverride shape
model FieldOverride {
  orgId    String
  typeKey  String
  disabled String[] @default([])
  order    String[] @default([])
  extra    Json     @default("[]") // FieldDef[] added by admin; server issues keys
  // server-issued counter for custom field keys (custom_{typeKey}_{kind}_{n})
  extraSeq Int      @default(0)
  // เด็ค Web 2026 ข้อ 10 · "บังคับผม เพิ่มเองได้ไหมครับ?" — ป้าย "บังคับ" เคย
  // เขียนตายตัวในโค้ด ทีมจึงต้องกรอกช่องที่บางทรัพย์ไม่มีข้อมูลจริง
  // เก็บเฉพาะช่องที่ถูกสั่งทับ { key: true|false } · ไม่มีคีย์ = ใช้ค่าตั้งต้น
  required Json     @default("{}")

  @@id([orgId, typeKey])
}

// Geography (§10 step 3): province/district/subdistrict/estate tree
model GeoItem {
  id       String    @id @default(cuid())
  orgId    String
  kind     String // province | district | subdistrict | estate
  name     String
  code     String? // 3-letter province code used in public_code (e.g. SPK)
  meta     Json? // { en?, type?, count? } — extra display fields per kind
  parentId String?
  parent   GeoItem?  @relation("GeoTree", fields: [parentId], references: [id])
  children GeoItem[] @relation("GeoTree")

  @@index([orgId, kind])
}

model MediaAsset {
  id            String   @id @default(cuid())
  orgId         String
  filename      String // original name
  mime          String
  size          Int
  path          String // public URL path, e.g. /uploads/xxxx.webp
  uploaderId    String?
  // FR-ADM-09: two watermark styles per image. `none` keeps the file as-is;
  // the others produce a derivative that is the ONLY thing served publicly,
  // while the untouched original stays available to signed-in admins.
  watermarkType String   @default("none") // none | corner | tiled
  createdAt     DateTime @default(now())

  @@index([orgId])
}

// per-prefix running number for public_code (FR-ADM-08), transaction-safe
model CodeCounter {
  orgId  String
  prefix String // "JKP" (Bangkok) or "JKP-SPK" etc.
  next   Int    @default(1)

  @@id([orgId, prefix])
}

model Property {
  id         String   @id @default(cuid())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id])
  publicCode String   @unique // JKP0118 / JKP-SPK0042 — immutable after create
  typeKey    String // house|condo|land|factory|warehouse|showroom
  title      String   @default("")
  // per-language title/description: { en: { title, description }, zh: {…} }
  // Thai lives in `title` above — it is the record's own language, not a copy
  i18n       Json     @default("{}")
  status     String   @default("draft") // draft|active|hidden|archived
  // all form values keyed by FieldDef.key (§4) — schema tells the meaning
  values     Json     @default("{}")
  ownerId    String? // owning agent — row-level scope 'own'
  /* สไลด์ 46 · "มีทรัพย์กลางที่แสดงเบอร์โทรและที่ตั้งของผู้ให้เช่าที่ทุกคนเห็นได้
     — เจ้าของตั้งเท่านั้น" ปกติเบอร์กับที่ตั้งของผู้ให้เช่าเห็นได้เฉพาะคนที่ลง
     ประกาศเอง (กับผู้จัดการและเจ้าของระบบ) ทรัพย์ที่ติดธงนี้เปิดให้ทุกคนเห็น */
  contactShared Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listings Listing[]

  @@index([orgId, typeKey])
  @@index([orgId, status])
}

model Listing {
  id          String    @id @default(cuid())
  orgId       String
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status      String    @default("draft") // draft|published|hidden|unavailable|archived
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId, status])
}

model Lead {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id])
  createdAt      DateTime @default(now())
  name           String
  phone          String
  email          String   @default("")
  company        String?
  respondentType String?
  message        String   @default("")
  typeKey        String
  typeLabel      String
  dealIntent     String
  req            Json     @default("[]") // ReqItem[] { k, v }
  source         String   @default("requirement form")
  status         String   @default("new") // 9-state pipeline (forward-only)
  assigneeId     String? // row-level scope 'own' checks this
  updatedAt      DateTime @updatedAt

  notes        LeadNote[]
  tasks        LeadTask[]
  requirements Requirement[]

  @@index([orgId, status])
  @@index([orgId, assigneeId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  text      String
  createdAt DateTime @default(now())
}

model LeadTask {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  title     String
  due       DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
}

// Flow B — what the customer is looking for, as a thing of its own.
//
// This used to live only as `Lead.req`, an untyped JSON list of {k,v} pairs, so
// a requirement had no status, could not be confirmed or cancelled, could not
// be corrected after it arrived, and had no list screen. Lead.req is kept as
// the raw record of what the form submitted; this table is what Ops work on.
model Requirement {
  id     String @id @default(cuid())
  orgId  String
  code   String // REQ-1042 — the number the team says out loud
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // submitted → confirmed → (shortlisted) · cancelled from anywhere
  status String @default("submitted")

  dealIntent String @default("") // เช่า | ขาย
  typeKey    String @default("") // warehouse | factory
  usage      String @default("") // คลังสินค้า/โลจิสติกส์ …

  // "ประเภทสินค้าและธุรกิจ" — ลูกค้าค้าอะไร (อาหารแช่แข็ง · ชิ้นส่วนยานยนต์ · อีคอมเมิร์ซ)
  // คนละเรื่องกับ usage ที่เป็นการใช้งานอาคาร · ขอไว้ในเด็ค Web 2026 ข้อ 14–17
  // เป็นตัวชี้ว่าทรัพย์หลังไหนเสนอได้จริง เช่น ของกินต้องคลังเย็น งานพ่นสีต้องมี ร.ง.4
  businessType String @default("")

  areaMin   Int? // ตร.ม.
  areaMax   Int?
  budgetMin Int? // บาท/เดือน สำหรับเช่า, บาท สำหรับขาย
  budgetMax Int?
  moveIn    DateTime?

  // the special conditions Ops must check against each property before it may
  // enter a shortlist (FR-AVL-04 §3.6)
  needsRor4 Boolean @default(false)
  nearPort  Boolean @default(false)
  pollution String  @default("") // free text: ประเภทกิจการที่อาจมีปัญหา
  note      String  @default("")

  // ranked provinces/districts, best first — [{ name }]
  locations Json @default("[]")

  // FR-CRM-07: cancelling must say why, and which requirement item was the problem
  cancelReason String    @default("")
  cancelField  String    @default("")
  cancelledAt  DateTime?
  confirmedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checks     AvailabilityCheck[]
  shortlists Shortlist[]

  @@unique([orgId, code])
  @@index([orgId, status])
  @@index([leadId])
}

// One "is it still free?" answer from the landlord, per property per
// requirement. The screen showed these as a hardcoded list of three.
model AvailabilityCheck {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  propertyId    String
  // available | unavailable — recorded by whoever rang the landlord
  result        String
  note          String      @default("")
  checkedBy     String?
  checkedAt     DateTime    @default(now())

  @@unique([requirementId, propertyId])
  @@index([requirementId])
}

model Shortlist {
  id            String       @id @default(cuid())
  orgId         String
  leadId        String?
  // set when the shortlist was built from a requirement (Flow B)
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  name          String       @default("")
  token         String       @unique // /client-shortlist?token=…
  status        String       @default("open") // open|sent|closed
  createdAt     DateTime     @default(now())

  items ShortlistItem[]

  @@index([requirementId])
}

model ShortlistItem {
  id          String    @id @default(cuid())
  shortlistId String
  shortlist   Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  propertyId  String
  note        String?
  sort        Int       @default(0)

  // What the customer said from the tokenized link (Flow B → C). The client
  // page asked for an opinion per property and had nowhere to put it, so the
  // team had to ring round for the answer they had already been given.
  // interested | maybe | not_interested
  feedback     String?
  feedbackNote String?
  feedbackAt   DateTime?
}

model Visit {
  id            String   @id @default(cuid())
  orgId         String
  leadId        String?
  date          DateTime
  status        String   @default("scheduled") // scheduled|done|cancelled
  note          String?
  // FR-AVL-04: the availability gate must be cleared before the route is usable
  gateConfirmed Boolean  @default(false)
  createdAt     DateTime @default(now())

  stops VisitStop[]
}

model VisitStop {
  id         String  @id @default(cuid())
  visitId    String
  visit      Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  propertyId String
  sort       Int     @default(0)
  result     String? // feedback after the visit
}

// Negotiation timeline on a deal (ฝั่งลูกค้า / ฝั่งเจ้าของ / ตกลง)
model DealOffer {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  side      String // ฝั่งลูกค้า | ฝั่งเจ้าของ | ตกลง
  amount    String // free text — "฿385,000/ด." keeps the unit the ops team types
  terms     String   @default("")
  createdAt DateTime @default(now())

  @@index([dealId])
}

model Deal {
  id         String    @id @default(cuid())
  orgId      String
  leadId     String?
  propertyId String?
  title      String    @default("")
  amount     Int       @default(0) // baht
  status     String    @default("negotiating") // negotiating|won|lost
  closedAt   DateTime?
  note       String?
  locked     Boolean   @default(false) // financials read-only after close (deal_unlock to reopen)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  offers DealOffer[]
  docs   DealDocument[]

  @@index([orgId, status])
}

// Files attached to a deal (§ Flow D). The screen listed three PDFs with
// sizes and upload dates next to an upload button with no handler; there was
// no table, no route and nowhere for a file to go. Stored through the same
// driver as the media library, so local disk and S3 both work unchanged.
model DealDocument {
  id         String   @id @default(cuid())
  orgId      String
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  filename   String
  mime       String
  size       Int
  // รอเซ็น | ครบ — what the team is waiting on, not a file property
  status     String   @default("รอเซ็น")
  uploaderId String?
  createdAt  DateTime @default(now())

  @@index([dealId])
}

// Lease book (§7.1) — real end dates, not day offsets
model Lease {
  id        String    @id @default(cuid())
  orgId     String
  code      String // property public_code
  title     String
  tenant    String
  startDate DateTime?
  endDate   DateTime
  rent      Int // baht / month
  status    String    @default("active") // active|renewed|closed
  href      String    @default("/admin/deals")
  createdAt DateTime  @default(now())

  @@index([orgId, status])
}

// Social status (§6.5)
model SocialChannel {
  orgId String
  key   String
  label String
  sort  Int    @default(0)

  @@id([orgId, key])
}

model SocialRecord {
  orgId String
  code  String // listing public_code
  text  String? // manual caption override; null = use buildSummary()
  /* สไลด์ 35 · "Social Status ไม่มีให้โหลดรูปภาพของแต่ละประกาศ · จำเป็น"
     รูปที่เตรียมไว้สำหรับโพสต์ประกาศนี้โดยเฉพาะ — คนละชุดกับรูปทรัพย์ เพราะรูป
     โพสต์มักครอปมาแล้ว มีข้อความทับ หรือเป็นรูปที่เลือกมาเฉพาะบางใบ
     ไม่มีก็ใช้รูปทรัพย์ตามเดิม */
  photos String[] @default([])

  @@id([orgId, code])
}

model SocialPost {
  orgId      String
  code       String
  channelKey String
  done       Boolean @default(false)
  date       String? // YYYY-MM-DD
  url        String?

  @@id([orgId, code, channelKey])
}

// CMS content item — one row per page / article / FAQ entry / certificate.
// The three CMS screens all read this table.
model CmsPage {
  id        String   @id @default(cuid())
  orgId     String
  kind      String   @default("articles") // pages|articles|faq|certs
  slug      String // base slug; the locale prefix is derived per language
  title     String
  category  String   @default("")
  status    String   @default("draft") // draft|published
  cover     String? // media src
  links     String[] @default([]) // internal links shown on the article
  // per-language body + translation completeness:
  // { th: { title, body, done }, en: {…}, zh: {…} }
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([orgId, kind, slug])
  @@index([orgId, kind])
}

// Page Builder / Sections — one canonical section row shared by both screens
// (they were two incompatible mock shapes; this is the superset).
model PageSection {
  id      String  @id @default(cuid())
  orgId   String
  pageKey String // home|about|contact
  key     String // stable per-page id: h, n, l, w, c, ah, as, ch, cm, custom…
  type    String  @default("section") // hero|section
  name    String
  desc    String  @default("")
  sort    Int     @default(0)
  enabled Boolean @default(true)
  img     String?
  // { th: { eyebrow, headline, sub, cta }, en: {…}, zh: {…} }
  content Json    @default("{}")

  @@unique([orgId, pageKey, key])
  @@index([orgId, pageKey])
}

// Branding — one row per tenant (12 presets live in the UI; this stores the
// resolved values). `device` is UI-only and deliberately not persisted.
model Branding {
  orgId     String   @id
  brandName String   @default("JKP Property")
  primary   String   @default("#034956")
  accent    String   @default("#034956")
  neon      String   @default("#2DFB91")
  pine      String   @default("#273c33")
  font      String   @default("noto") // noto|plex|inter
  radius    String   @default("md") // sharp|sm|md|round
  logo      String? // media src
  // Watermark stamped on every property photo the public sees (FR-ADM-09b).
  // wmVersion bumps whenever a rendered property changes, so cached
  // derivatives and browser caches are invalidated by URL rather than purged.
  wmEnabled Boolean  @default(false)
  wmSrc     String? // media src of the uploaded logo
  /* free = วางตาม wmX/wmY · tiled = เรียงเต็มภาพ
     ค่าเก่าเป็นชื่อมุมทั้ง 9 (bottom-right ฯลฯ) — migration แปลงเป็น x/y ให้แล้ว */
  wmAnchor  String   @default("free") // free | tiled
  /* ตำแหน่งเป็น % ของที่ว่างในภาพ 0 = ชิดซ้าย/บน · 100 = ชิดขวา/ล่าง */
  wmX       Int      @default(100)
  wmY       Int      @default(100)
  wmScale   Int      @default(18) // % of photo width
  wmOpacity Int      @default(70) // %
  wmMargin  Int      @default(3) // % of photo width
  wmVersion Int      @default(0)
  updatedAt DateTime @updatedAt
}

// SEO / GEO add-on: subscription flag + the two AI-readable files
model SeoConfig {
  orgId      String   @id
  subscribed Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model SeoFile {
  orgId      String
  key        String // llms | robots
  filename   String
  sizeBytes  Int
  body       String // .txt content, served verbatim at /llms.txt and /robots.txt
  uploadedAt DateTime @default(now())

  @@id([orgId, key])
}

// Audit log — every mutation, before/after JSON (SPEC_PACK cross-cutting rule)
model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  userName  String? // denormalised for display
  action    String // e.g. property.create, lead.status, pii.reveal
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

/**
 * Company contact details — one row per org.
 * The address, the two phone numbers and the two mailboxes were spread across
 * a component, the dictionary and a page's props. They had already drifted:
 * the About and FAQ footers were serving info@thaiindustrialproperty.com, a
 * domain the company does not own, and +66 90-000-0000, a number that does not
 * ring. This is the single place they live now.
 * The translated fields are Json ({ th, en, zh }) to match how PageSection
 * stores copy; the rest are the same in every language.
 */
model CompanyProfile {
  orgId         String   @id
  legalName     String   @default("")
  /**
   * { th, en, zh } — the full postal address
   */
  address       Json?
  /**
   * { th, en, zh } — the short form used in footers, e.g. "สมุทรปราการ, ประเทศไทย"
   */
  shortLocation Json?
  /**
   * [{ number, label }] — label names the language the line is answered in
   */
  phones        Json?
  salesEmail    String   @default("")
  generalEmail  String   @default("")
  /**
   * { th, en, zh } — e.g. "จันทร์ - ศุกร์:"
   */
  hoursDays     Json?
  hoursValue    String   @default("")
  /**
   * Contact channels. The icons for these were `href="#"` on the contact page
   * and in both footers — eighteen dead links in all. An empty value hides
   * its icon rather than rendering one that goes nowhere.
   */
  lineUrl       String   @default("")
  facebookUrl   String   @default("")
  whatsappUrl   String   @default("")
  instagramUrl  String   @default("")
  /* WeChat is an ID, not a URL — there is no link a browser may open into the
     app — so the site shows it to be copied, and the share menu offers the
     page as a QR code for the scanner instead. */
  wechatId      String   @default("")
  updatedAt     DateTime @updatedAt
}
