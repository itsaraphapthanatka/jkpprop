# One-shot container that brings the database up to date before the app boots.
#
# Kept separate from the runtime image because `prisma migrate deploy` needs
# the CLI and the migration files, neither of which belong in a production
# image that only has to serve requests.
FROM node:22-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

# No package.json from the app: with one present, npm installs that whole tree
# — next, react, sharp, and with `npm i` the devDependencies as well. This image
# only runs `prisma migrate deploy`, and it was 2.26 GB (2.34 GB once npm was
# also pulling the dev tree) against the app's 543 MB, downloaded on every
# deploy. Its own tiny manifest, and only the four packages it uses.
RUN npm init -y > /dev/null \
  && npm i --no-audit --no-fund prisma@6.19.3 @prisma/client@6.19.3 tsx bcryptjs

COPY prisma ./prisma
RUN npx prisma generate

# `migrate deploy` applies committed migrations and never prompts or resets —
# the only safe variant against a database with real data in it
CMD ["npx", "prisma", "migrate", "deploy"]
