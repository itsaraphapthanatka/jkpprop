# --- required ---------------------------------------------------------------
# Postgres. On serverless, point this at a POOLED connection (pgBouncer /
# Prisma Accelerate / Neon pooler) — a direct connection runs out of slots.
DATABASE_URL="postgresql://user:password@localhost:5432/jkpprop"

# --- media storage ----------------------------------------------------------
# Leave every S3_* var unset to store uploads on local disk (web/uploads/).
# That is fine for dev and for a single long-lived server, but on serverless
# the filesystem is wiped on each deploy — set these four to switch drivers.
# S3_BUCKET="jkp-media"
# S3_REGION="ap-southeast-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# S3-compatible hosts (Cloudflare R2, MinIO, DigitalOcean Spaces) need this:
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"

# Serve files straight from a CDN instead of proxying through /api/media/:id/raw:
# S3_PUBLIC_BASE_URL="https://cdn.example.com"
