{
  "$meta": {
    "name": "JKP Property — Design Tokens (Handoff)",
    "version": "1.0.0",
    "source": "JKP_Property_Handoff.md",
    "directive": "Per user directive 2026-07-22: this project follows the HANDOFF design system ONLY, superseding the green-first canonical set (08 / green-brand-*).",
    "note": "Values marked derived are not specified in the handoff."
  },
  "color": {
    "brand": {
      "neonGreen": "#2DFB91",
      "green600": "#0D6C3B",
      "accentTeal": "#034956",
      "pine": "#273c33",
      "gold": "#D9A62B",
      "purpleAdmin": "#7A3FB0",
      "danger": "#C0392B",
      "emeraldGradient": ["#0B7A45", "#0A5C39", "#043F20"],
      "footer": "#04140C",
      "sidebar": "#0A0E0C"
    },
    "surface": {
      "base": "#F9F8F5",
      "alt": "#F3F0EC",
      "card": "#FFFFFF",
      "tint": "#EEF4F3",
      "muted": "#ECE8E1 (derived)"
    },
    "text": {
      "primary": "#28251D",
      "secondary": "#5F5A52",
      "muted": "#7A7974",
      "muted3": "#9B968D",
      "inverse": "#FFFFFF",
      "accent": "#034956"
    },
    "border": {
      "default": "#E7E3DC",
      "subtle": "#EFECE6 (derived)",
      "card": "1.5px"
    }
  },
  "font": {
    "family": {
      "primary": "'Noto Sans Thai', 'Inter', 'Segoe UI', sans-serif",
      "mono": "'JetBrains Mono', 'SFMono-Regular', 'Menlo', monospace"
    },
    "weights": [400, 500, 600, 700, 800],
    "scale": {
      "eyebrow": "13px/700 uppercase letterSpacing 0.08em",
      "body": "15-16px/400",
      "price": "21px/800 mono",
      "h3": "22px/800",
      "h2": "34px/700",
      "h1": "44px/700 (mobile 34/28)"
    }
  },
  "space": ["4px", "8px", "16px", "24px", "44px", "88px"],
  "radius": { "sm": "10-12px", "md": "16-18px", "lg": "20-24px", "full": "9999px" },
  "icon": { "library": "lucide-react", "style": "iOS/SF-Symbols line", "stroke": "1.7px", "viewBox": "24x24" },
  "motion": {
    "hoverLift": "translateY(-2px) 0.2s",
    "cardHover": "0.3s cubic-bezier(.2,.7,.3,1) + shadow",
    "drawerModal": "0.35s slide",
    "backdrop": "rgba(2,14,8,0.55) + blur(3px)",
    "scrollReveal": "fade + translateY 28px"
  },
  "componentPatterns": {
    "button": "pill (border-radius 9999px) + hover lift/glow",
    "card": "border 1.5px + hover lift + shadow",
    "chipsBadges": "small pill",
    "modal": "center, max-width 460-520px, radius 20px, header/body/footer split",
    "adminShell": "dark sidebar 248px fixed + topbar sticky blur + main scroll"
  },
  "derivedGaps": [
    "shadow scale values",
    "focus ring",
    "info status color (from teal)",
    "surface.muted / border.subtle",
    "z-index scale",
    "no full dark theme (near-black used as footer/sidebar surfaces only)"
  ]
}
