# Copy to .env next to docker-compose.yml and fill in. Never commit the copy.

# --- required ---------------------------------------------------------------
# the domain already pointed at this VPS; Caddy gets the certificate for it
DOMAIN=jkpproperty.co.th
# Let's Encrypt sends expiry warnings here
TLS_EMAIL=ops@jkpproperty.co.th

# database password — generate one, do not reuse
# openssl rand -base64 24
POSTGRES_PASSWORD=

# --- optional ---------------------------------------------------------------
POSTGRES_USER=jkp
POSTGRES_DB=jkpprop

# Uploads live on the VPS disk by default (the `uploads` volume), which is the
# right choice for a single server. Set all four to move them to an
# S3-compatible bucket instead — useful once there is more than one app node.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# for Cloudflare R2 / MinIO / Spaces
# S3_ENDPOINT=
# to serve media straight from a CDN
# S3_PUBLIC_BASE_URL=
